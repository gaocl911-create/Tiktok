{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "兼职工作"
      }
    },
    {
      "path": "pages/tasks/index",
      "style": {
        "navigationBarTitleText": "任务广场",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/works/index",
      "style": {
        "navigationBarTitleText": "我的作品",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/works/submit",
      "style": {
        "navigationBarTitleText": "提交作品"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心"
      }
    },
    {
      "path": "pages/profile/edit",
      "style": {
        "navigationBarTitleText": "兼职资料"
      }
    }
  ],
  "tabBar": {
    "color": "#77736b",
    "selectedColor": "#0b0b0b",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/tasks/index",
        "text": "任务",
        "iconPath": "static/tabbar/tasks.png",
        "selectedIconPath": "static/tabbar/tasks-active.png"
      },
      {
        "pagePath": "pages/works/index",
        "text": "作品",
        "iconPath": "static/tabbar/works.png",
        "selectedIconPath": "static/tabbar/works-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "创作者任务",
    "navigationBarBackgroundColor": "#f6f5f1",
    "backgroundColor": "#f6f5f1",
    "backgroundTextStyle": "dark"
  }
}
