FROM node:22-alpine AS build

WORKDIR /app
COPY web/package*.json ./
RUN npm ci

COPY web ./
ARG VITE_APP_TITLE=创作者监测
ARG VITE_APP_LOGO_TITLE=创作者监测
ARG VITE_APP_ENV=production
ARG VITE_APP_CONTEXT_PATH=/
ARG VITE_APP_MONITOR_ADMIN=/admin/applications
ARG VITE_APP_SNAILJOB_ADMIN=/snail-job
ARG VITE_APP_BASE_API=/prod-api
ARG VITE_BUILD_COMPRESS=gzip
ARG VITE_APP_RSA_PUBLIC_KEY
ARG VITE_APP_CLIENT_ID
ARG VITE_APP_WEBSOCKET=false
ARG VITE_APP_SSE=true
ENV VITE_APP_TITLE=${VITE_APP_TITLE}
ENV VITE_APP_LOGO_TITLE=${VITE_APP_LOGO_TITLE}
ENV VITE_APP_ENV=${VITE_APP_ENV}
ENV VITE_APP_CONTEXT_PATH=${VITE_APP_CONTEXT_PATH}
ENV VITE_APP_MONITOR_ADMIN=${VITE_APP_MONITOR_ADMIN}
ENV VITE_APP_SNAILJOB_ADMIN=${VITE_APP_SNAILJOB_ADMIN}
ENV VITE_APP_BASE_API=${VITE_APP_BASE_API}
ENV VITE_BUILD_COMPRESS=${VITE_BUILD_COMPRESS}
ENV VITE_APP_RSA_PUBLIC_KEY=${VITE_APP_RSA_PUBLIC_KEY}
ENV VITE_APP_CLIENT_ID=${VITE_APP_CLIENT_ID}
ENV VITE_APP_WEBSOCKET=${VITE_APP_WEBSOCKET}
ENV VITE_APP_SSE=${VITE_APP_SSE}
RUN test -n "$VITE_APP_RSA_PUBLIC_KEY" && test -n "$VITE_APP_CLIENT_ID"
RUN npm run build:prod

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
