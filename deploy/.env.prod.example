# ============================================================
# 生产环境 .env —— 复制为 deploy/.env.prod 并填入真实值
# ============================================================
# 标记为 (REQUIRED) 的项缺失或为弱默认值时容器启动会 fail-fast。
# 所有密钥/密码上线前先用强随机串轮换一次。

# Docker 容器前缀（同一台机器跑多套时区分用，可不动）
CONTAINER_PREFIX=tiktok-platform

# ---------- 数据库（仅 docker 内网访问，宿主机不暴露端口） ----------
MYSQL_DATABASE=ry-vue
# (REQUIRED) MySQL root 密码 —— 32+ 字符随机串
MYSQL_ROOT_PASSWORD=
# (REQUIRED) 应用连接用的 MySQL 账号；建议单独建一个最小权限用户，而不是 root。
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ---------- Redis（仅内网） ----------
# (REQUIRED) Redis 密码 —— 32+ 字符随机串
REDIS_PASSWORD=

# ---------- MinIO（仅内网） ----------
# (REQUIRED)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------- SnailJob ----------
# (REQUIRED) SnailJob 接入 token，对应 sj_group_config.token；上线前轮换。
SNAIL_JOB_TOKEN=

# ---------- 后端密钥 ----------
# (REQUIRED) sa-token JWT 签名密钥；64+ 字符随机串。
SA_TOKEN_JWT_SECRET=
# (REQUIRED) 接口加解密 RSA keypair；前端公钥放 web/.env.production 的 VITE_APP_RSA_PUBLIC_KEY。
# 用 openssl 生成：
#   openssl genrsa -out priv.pem 2048
#   openssl rsa -in priv.pem -pubout -out pub.pem
# 然后把 PEM 头尾去掉、换行去掉，整体复制到这里。
API_DECRYPT_REQUEST_PRIVATE_KEY=
API_DECRYPT_RESPONSE_PUBLIC_KEY=

# (REQUIRED) CORS 白名单 —— 逗号分隔；不要写 *。
# 例如 https://app.your-domain.com,https://admin.your-domain.com
CORS_ALLOWED_ORIGINS=

# ---------- TikHub ----------
TIKHUB_ENABLED=false
TIKHUB_API_TOKEN=

# ---------- 微信小程序 ----------
# (REQUIRED) 小程序后台的 AppID 与 AppSecret
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_APP_SECRET=
# 模拟登录开关：prod profile 下后端硬拒绝 mock 路径，这里强制 false。
WECHAT_MINIAPP_MOCK_ENABLED=false

# ---------- 对外暴露端口（仅 web/nginx 这一层） ----------
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ---------- JVM ----------
JAVA_OPTS=-Xms512m -Xmx1024m
