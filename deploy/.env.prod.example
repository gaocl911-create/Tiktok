# ============================================================
# Production env template
# Copy this file to deploy/.env.prod and fill real values.
# Do not commit deploy/.env.prod.
# ============================================================

CONTAINER_PREFIX=tiktok-platform

# ---------- MySQL, docker internal only ----------
MYSQL_DATABASE=ry-vue
MYSQL_ROOT_PASSWORD=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ---------- Redis, docker internal only ----------
REDIS_PASSWORD=

# ---------- MinIO, docker internal only ----------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------- SnailJob ----------
# Must match sj_group_config.token in database.
SNAIL_JOB_TOKEN=

# ---------- Backend secrets ----------
SA_TOKEN_JWT_SECRET=

# RSA keypair for request decryption / optional response encryption.
# Generate:
#   openssl genrsa -out request-priv.pem 2048
#   openssl rsa -in request-priv.pem -pubout -out request-pub.pem
# Put private key body, without BEGIN/END/newlines, into API_DECRYPT_REQUEST_PRIVATE_KEY.
# Put the matching request public key body into WEB_RSA_PUBLIC_KEY below.
API_DECRYPT_REQUEST_PRIVATE_KEY=
API_DECRYPT_RESPONSE_PUBLIC_KEY=

# ---------- Web build args ----------
# Required by Dockerfile.web during `docker compose build web`.
WEB_APP_TITLE=创作者监测
WEB_APP_LOGO_TITLE=创作者监测
WEB_CONTEXT_PATH=/
WEB_MONITOR_ADMIN=/admin/applications
WEB_SNAILJOB_ADMIN=/snail-job
WEB_BASE_API=/prod-api
WEB_BUILD_COMPRESS=gzip
# Must be the public key matching API_DECRYPT_REQUEST_PRIVATE_KEY.
WEB_RSA_PUBLIC_KEY=
# Production client id from sys_client table.
WEB_CLIENT_ID=
WEB_WEBSOCKET=false
WEB_SSE=true

# ---------- CORS ----------
# Comma-separated origins. Do not use "*".
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ---------- TikHub ----------
TIKHUB_ENABLED=false
TIKHUB_API_TOKEN=

# ---------- WeChat Mini Program ----------
WECHAT_MINIAPP_APPID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_MINIAPP_MOCK_ENABLED=false

# ---------- Public web ports ----------
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# ---------- JVM ----------
JAVA_OPTS=-Xms512m -Xmx1024m
